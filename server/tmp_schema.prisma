generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.olgkiuvwufildvzqbpiw:hBfbrLjmHNdPzwTc@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"

model User {
  id                         String                  @id @default(cuid())
  name                       String
  email                      String                  @unique
  password                   String?
  role                       String                  @default("member")
  avatar                     String?
  bio                        String?
  locale                     String                  @default("en")
  theme                      String                  @default("dark")
  verified                   Boolean                 @default(false)
  verificationToken          String?
  resetToken                 String?
  resetTokenExpires          DateTime?
  level                      ReaderLevel             @default(BRONZE)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  articles                   Article[]               @relation("ArticleAuthor")
  bookmarks                  Bookmark[]
  comments                   Comment[]
  novels                     Novel[]                 @relation("NovelAuthor")
  orders                     Order[]
  ratings                    Rating[]
  likes                      Like[]
  reactions                  Reaction[]
  pollVotes                  PollVote[]
  communityThreads           CommunityThread[]
  notifications              Notification[]
  badges                     Badge[]
  follows                    Follow[]                @relation("UserFollows")
  following                  Follow[]                @relation("UserFollowing")
  notificationSettings       NotificationSettings?
  quotes                     Quote[]
  series                     Series[]                @relation("SeriesAuthor")
  bookReviews                BookReview[]
  reviewHelpful              ReviewHelpful[]
  readingStatuses            ReadingStatus[]
  leaderboardSnapshots       LeaderboardSnapshot[]
  communityThreadMemberships CommunityThreadMember[]
  reportsMade                Report[]                @relation("ReportReporter")
  reportsAgainst             Report[]                @relation("ReportResolver")
  resolvedReports            Report[]                @relation("ReportResolverId")
  studyCircleGoals           StudyCircleGoal[]
  studyCircleNotes           StudyCircleNote[]
  studyCircleAssignments     StudyCircleAssignment[]
  studyCircleSubmissions     StudyCircleSubmission[]
}

model Article {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String
  content     String
  category    String
  language    String
  readingTime String
  authorName  String
  coverImage  String?
  views       Int        @default(0)
  claps       Int        @default(0)
  featured    Boolean    @default(false)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String?
  author      User?      @relation("ArticleAuthor", fields: [authorId], references: [id], onUpdate: NoAction)
  bookmarks   Bookmark[]
  comments    Comment[]
  ratings     Rating[]
  likes       Like[]
}

model Novel {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  coverImage  String
  authorName  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String?
  bookmarks   Bookmark[]
  chapters    Chapter[]
  parts       Part[]
  comments    Comment[]
  author      User?      @relation("NovelAuthor", fields: [authorId], references: [id], onUpdate: NoAction)
  ratings     Rating[]
  likes       Like[]
}

model Part {
  id        String    @id @default(cuid())
  title     String
  number    Int
  novelId   String
  novel     Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapters  Chapter[] @relation("PartChapters")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([novelId, number])
}

model Chapter {
  id          String     @id @default(cuid())
  novelId     String
  partId      String?
  title       String
  number      Int
  content     String
  readingTime String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bookmarks   Bookmark[]
  novel       Novel      @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  part        Part?      @relation("PartChapters", fields: [partId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  comments    Comment[]
  ratings     Rating[]
  likes       Like[]
  polls       Poll[]

  @@unique([novelId, number])
}

model Book {
  id              String          @id @default(cuid())
  title           String
  author          String
  price           Float
  format          String
  summary         String
  coverImage      String
  stock           Int
  fileUrl         String?
  previewUrl      String?
  genre           String?
  language        String?
  pageCount       Int?
  publishedAt     DateTime?
  isbn            String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bookmarks       Bookmark[]
  comments        Comment[]
  orderItems      OrderItem[]
  ratings         Rating[]
  likes           Like[]
  reviews         BookReview[]
  readingStatuses ReadingStatus[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  email           String
  subtotal        Float
  total           Float
  discountCode    String?
  discountAmount  Float       @default(0)
  stripeSessionId String?     @unique
  status          String      @default("paid")
  currency        String      @default("usd")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id], onUpdate: NoAction)
  items           OrderItem[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  bookId          String
  titleSnapshot   String
  priceAtPurchase Float
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())
  book            Book     @relation(fields: [bookId], references: [id], onUpdate: NoAction)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Comment {
  id          String           @id @default(cuid())
  content     String
  approved    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      String
  articleId   String?
  novelId     String?
  chapterId   String?
  bookId      String?
  communityId String?
  parentId    String?
  isEdited    Boolean          @default(false)
  isDeleted   Boolean          @default(false)
  isPinned    Boolean          @default(false)
  article     Article?         @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book        Book?            @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter     Chapter?         @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  novel       Novel?           @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  community   CommunityThread? @relation(fields: [communityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent      Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies     Comment[]        @relation("CommentReplies")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports     Report[]

  @@index([communityId])
  @@index([userId])
}

model Rating {
  id        String   @id @default(cuid())
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  articleId String?
  novelId   String?
  chapterId String?
  bookId    String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  novel     Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, articleId])
  @@unique([userId, bookId])
  @@unique([userId, chapterId])
  @@unique([userId, novelId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  articleId String?
  novelId   String?
  chapterId String?
  bookId    String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  novel     Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, articleId])
  @@unique([userId, bookId])
  @@unique([userId, chapterId])
  @@unique([userId, novelId])
}

model Like {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  userId      String
  articleId   String?
  novelId     String?
  chapterId   String?
  bookId      String?
  communityId String?
  reviewId    String?
  article     Article?         @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book        Book?            @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter     Chapter?         @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  novel       Novel?           @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  community   CommunityThread? @relation(fields: [communityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  review      BookReview?      @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, articleId])
  @@unique([userId, bookId])
  @@unique([userId, chapterId])
  @@unique([userId, novelId])
  @@unique([userId, communityId])
  @@unique([userId, reviewId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  category  String
  imageUrl  String
  createdAt DateTime @default(now())
}

model TechArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  series      String
  tags        String
  excerpt     String
  code        String
  publishedAt DateTime @default(now())
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  type             String    @default("percent")
  value            Float
  active           Boolean   @default(true)
  maxUses          Int?
  usedCount        Int       @default(0)
  minSubtotal      Float?
  startsAt         DateTime?
  endsAt           DateTime?
  perItem          Boolean   @default(false)
  applicableBookId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  author    String
  text      String
  createdAt DateTime @default(now())
}

model Reaction {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  emoji       String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, contentId])
  @@index([contentId, contentType])
}

model Poll {
  id          String       @id @default(cuid())
  contentId   String
  contentType String
  chapterId   String?
  question    String
  type        String       @default("single")
  isAnonymous Boolean      @default(false)
  isPublic    Boolean      @default(true)
  closesAt    DateTime?
  createdBy   String
  createdAt   DateTime     @default(now())
  chapter     Chapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options     PollOption[]
  votes       PollVote[]

  @@unique([contentId, contentType])
  @@index([createdBy])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  votes     PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String?
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model CommunityThread {
  id                     String                  @id @default(cuid())
  authorId               String
  contentId              String?
  contentType            String?
  category               String
  title                  String
  body                   String
  threadType             String                  @default("discussion") // discussion | room | study_circle
  isPinned               Boolean                 @default(false)
  isLocked               Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  author                 User                    @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parentId               String?
  parent                 CommunityThread?        @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies                CommunityThread[]       @relation("ThreadReplies")
  likes                  Like[]
  comments               Comment[]
  bookmarks              CommunityBookmark[]
  members                CommunityThreadMember[]
  reports                Report[]
  schedule               StudyCircleSchedule?
  studyCircleGoals       StudyCircleGoal[]
  studyCircleNotes       StudyCircleNote[]
  studyCircleAssignments StudyCircleAssignment[]

  @@index([threadType])
  @@index([category])
  @@index([authorId])
  @@index([contentId, contentType])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  actorId   String?
  actorName String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, isRead])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  user        User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  badgeKey    String
  title       String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, badgeKey])
  @@index([userId])
}

model ReadingHistory {
  id          String   @id @default(cuid())
  userId      String
  contentType String
  contentId   String
  title       String?
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, contentType, contentId])
  @@index([userId])
}

model CommunityBookmark {
  id        String          @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime        @default(now())
  thread    CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, threadId])
  @@index([userId])
}

model NotificationSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  likes              Boolean  @default(true)
  comments           Boolean  @default(true)
  replies            Boolean  @default(true)
  reactions          Boolean  @default(true)
  pollVotes          Boolean  @default(true)
  newChapter         Boolean  @default(true)
  newArticle         Boolean  @default(true)
  discussionMentions Boolean  @default(true)
  circleActivity     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model Quote {
  id           String   @id @default(cuid())
  userId       String
  contentId    String
  contentType  String
  selectedText String
  startOffset  Int?
  endOffset    Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, contentId, startOffset, endOffset])
  @@index([userId])
  @@index([contentId, contentType])
}

model PurchaseHistory {
  id              String   @id @default(cuid())
  stripeSessionId String?
  userId          String?
  email           String
  subtotal        Float    @default(0)
  total           Float    @default(0)
  discountCode    String?
  discountAmount  Float    @default(0)
  currency        String   @default("usd")
  status          String   @default("paid")
  items           String?
  createdAt       DateTime @default(now())
}

// ─── Reading Series ────────────────────────────────────────────────────────
// Polymorphic model allowing series to contain articles, chapters, novels, etc.

model Series {
  id                   String       @id @default(cuid())
  title                String
  slug                 String       @unique
  description          String
  coverImage           String?
  estimatedReadingTime String // e.g. "15 min read"
  difficulty           String       @default("intermediate") // beginner | intermediate | advanced
  category             String
  authorName           String
  authorId             String?
  author               User?        @relation("SeriesAuthor", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items                SeriesItem[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([category])
  @@index([authorId])
}

model SeriesItem {
  id          String   @id @default(cuid())
  seriesId    String
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contentType String // "article" | "chapter" | "novel" (future: "book")
  contentId   String
  order       Int // position within the series
  createdAt   DateTime @default(now())

  @@unique([seriesId, contentId, contentType])
  @@unique([seriesId, order])
  @@index([contentId, contentType])
}

// ─── Book Reviews ──────────────────────────────────────────────────────────

enum ReadingStatusType {
  WANT_TO_READ
  CURRENTLY_READING
  COMPLETED
}

model BookReview {
  id           String   @id @default(cuid())
  bookId       String
  userId       String
  rating       Int // 1-5 stars
  content      String
  title        String?
  language     String   @default("en")
  status       String   @default("published") // published | draft | hidden | pending_review
  helpfulCount Int      @default(0) // denormalized count kept in sync with ReviewHelpful
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  book    Book            @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  helpful ReviewHelpful[]
  likes   Like[]

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
  @@index([rating])
  @@index([language])
  @@index([status])
  @@index([createdAt])
  @@index([helpfulCount])
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review BookReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model ReadingStatus {
  id        String            @id @default(cuid())
  userId    String
  bookId    String
  status    ReadingStatusType // WANT_TO_READ | CURRENTLY_READING | COMPLETED
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

// ─── Community Leaderboard ─────────────────────────────────────────────────

enum ReaderLevel {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  LEGEND
}

// Cached per-period rankings for fast leaderboard reads.
model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  period    String // daily | weekly | monthly | alltime
  periodKey String // e.g. 2025-06-01, 2025-W23, 2025-06, "all"
  userId    String
  score     Int
  rank      Int
  metrics   Json // per-metric breakdown for the row
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([period, periodKey, userId])
  @@index([period, periodKey, score])
}

// ─── Sprint 15: Live Discussion Rooms & Study Circles ──────────────────────
// All additions are additive and backward compatible. These models extend the
// existing CommunityThread/Comment/Reaction/Poll/Notification infrastructure.

// Membership for a live discussion room or study circle (threadType = "room"
// or "study_circle"). Reuses CommunityThread as the parent entity.
model CommunityThreadMember {
  id         String          @id @default(cuid())
  threadId   String
  userId     String
  role       String          @default("member") // member | moderator | owner
  status     String          @default("active") // active | muted | left
  mutedUntil DateTime?
  joinedAt   DateTime        @default(now())
  lastReadAt DateTime? // for unread-message tracking
  thread     CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([threadId, userId])
  @@index([threadId, status])
  @@index([userId])
}

// Moderation reports for threads, chat messages (comments), and members.
model Report {
  id             String           @id @default(cuid())
  threadId       String?
  commentId      String?
  reporterId     String
  reportedUserId String
  reason         String
  status         String           @default("open") // open | resolved | dismissed
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
  resolverId     String?
  thread         CommunityThread? @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comment        Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reportedUser   User             @relation("ReportResolver", fields: [reportedUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolver       User?            @relation("ReportResolverId", fields: [resolverId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([threadId])
  @@index([commentId])
  @@index([status])
  @@index([reporterId])
  @@index([reportedUserId])
}

// ─── Study Circles ─────────────────────────────────────────────────────────

// Reading schedule for a study circle (one per circle, replaces the need for a
// separate generic calendar model).
model StudyCircleSchedule {
  id        String          @id @default(cuid())
  circleId  String          @unique // CommunityThread of threadType = "study_circle"
  dayOfWeek Int             @default(1) // 1=Mon ... 7=Sun
  timeOfDay String          @default("18:00")
  timezone  String          @default("UTC")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  circle    CommunityThread @relation(fields: [circleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Weekly goals within a study circle.
model StudyCircleGoal {
  id          String          @id @default(cuid())
  circleId    String
  title       String
  description String?
  target      Int             @default(1)
  progress    Int             @default(0)
  week        String // e.g. "2025-W23"
  status      String          @default("active") // active | completed | archived
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  circle      CommunityThread @relation(fields: [circleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User            @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([circleId, week, title])
  @@index([circleId, week])
  @@index([createdBy])
}

// Shared notes for a study circle.
model StudyCircleNote {
  id        String          @id @default(cuid())
  circleId  String
  authorId  String
  title     String
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  circle    CommunityThread @relation(fields: [circleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([circleId])
  @@index([authorId])
}

// Assignments within a study circle.
model StudyCircleAssignment {
  id          String                  @id @default(cuid())
  circleId    String
  createdBy   String
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  circle      CommunityThread         @relation(fields: [circleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator     User                    @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submissions StudyCircleSubmission[]

  @@index([circleId])
  @@index([createdBy])
}

// Submissions for study circle assignments.
model StudyCircleSubmission {
  id           String                @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  score        Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  assignment   StudyCircleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

enum AdPosition {
  HOMEPAGE
  SIDEBAR
  BETWEEN_ARTICLES
  FOOTER
  CATEGORY
}

model Ad {
  id           String      @id @default(cuid())
  title        String
  provider     String
  providerData Json?
  position     AdPosition
  priority     Int         @default(0)
  targeting    Json?
  startAt      DateTime?
  endAt        DateTime?
  enabled      Boolean     @default(true)
  bannerUrl    String?
  clickUrl     String?
  altText      String?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  metrics      AdMetric[]
}

model AdMetric {
  id        String   @id @default(cuid())
  adId      String
  type      String
  meta      Json?
  createdAt DateTime @default(now())
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([adId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([target, targetId])
  @@index([createdAt])
}
